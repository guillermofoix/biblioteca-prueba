# Copia este fichero como .env y sustituye los valores de ejemplo.
# Para docker-compose.yml (PostgreSQL en un contenedor):
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=cambia-esta-contrasena
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta

# Para docker-compose.rds.yml (PostgreSQL gestionado en RDS), configura también:
# DATABASE_URL=postgresql://usuario:[REDACTED]@host-rds:5432/biblioteca
